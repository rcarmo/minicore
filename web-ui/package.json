{
  "name": "@minicore/web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:browser": "bun run test:bdd",
    "format": "prettier --write src scripts e2e playwright*.config.ts ../scripts",
    "lint": "prettier --check src scripts e2e playwright*.config.ts ../scripts",
    "test:bdd": "bddgen -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts"
  },
  "dependencies": {
    "preact": "10.27.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@cucumber/gherkin": "35.1.0",
    "@cucumber/messages": "28.1.0",
    "@playwright/test": "1.55.1",
    "@types/bun": "1.3.12",
    "@types/three": "0.180.0",
    "playwright-bdd": "8.4.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
